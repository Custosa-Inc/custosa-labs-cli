{
 "retentionPolicy": {
  "retentionPeriod": "0"
 },
 "lifecycle": {
  "rule": [
   {
    "action": {
     "type": "SetStorageClass",
     "storageClass": "COLDLINE"
    },
    "condition": {
     "age": 30
    }
   },
   {
    "action": {
     "type": "Delete"
    },
    "condition": {
     "age": 400
    }
   },
   {
    "action": {
     "type": "Delete"
    },
    "condition": {
     "numNewerVersions": 3
    }
   }
  ]
 }
}
